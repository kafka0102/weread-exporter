# 微信读书导出 / 书架抓取 — 网页操作 sleep 间隔（单位：秒）
# 按需调整；进程环境变量优先生效。
# 完整说明见 AGENTS.md

# ---- 登录会话 (weread_session.py) ----
SLEEP_LOGIN_SWITCH_PC=1
SLEEP_LOGIN_AFTER_GOTO=3
SLEEP_LOGIN_POLL=2

# ---- 书架抓取 (fetch_shelf.py) ----
SLEEP_SHELF_AFTER_LOAD=3
SLEEP_SHELF_SCROLL=3
# 作者为空时逐本打开详情；相邻两本之间的间隔（默认 5）
SLEEP_BOOK_DETAIL_INTERVAL=5
SLEEP_BOOK_DETAIL_LOAD=3
SLEEP_BOOK_DETAIL_CATALOG=1.5

# ---- 阅读器导出 (export_precise.py) ----
# 0=自动匹配「最大单块屏幕」可用逻辑像素（多显示器取外接大屏，而非虚拟桌面并集）
# 自动尺寸再受 MAX 上限约束，避免整屏铺满外接显示器；显式写死宽高时不受 MAX 限制
# 强制单页会收窄 CSS 视口，多数书仍保持双 canvas，失败后会自动恢复宽视口
READER_VIEWPORT_WIDTH=0
READER_VIEWPORT_HEIGHT=0
READER_VIEWPORT_MAX_WIDTH=1600
READER_VIEWPORT_MAX_HEIGHT=1000
READER_FORCE_SINGLE_PAGE=0
SLEEP_READER_AFTER_LOAD=5
SLEEP_READER_CATALOG_OPEN=1.5
SLEEP_READER_CATALOG_SCROLL=1
SLEEP_READER_CATALOG_CLICK=3
SLEEP_READER_CATALOG_CLOSE=2
SLEEP_READER_AFTER_HOOK=0.5
SLEEP_READER_PAGE_TURN=1
SLEEP_READER_PAGE_RENDER=0.3
SLEEP_READER_REOPEN=3
SLEEP_READER_STABLE_POLL=0.5

# ---- 书间 / 章间节奏 (export_precise.py 批量与切章) ----
# 批量导出相邻两本书之间的间隔（秒）
SLEEP_BOOK_INTERVAL=60
# 章完成后按字数动态等待：ceil(字数/1000)*PER_1K，夹到 [MIN, MAX]
SLEEP_CHAPTER_PER_1K_CHARS=1
SLEEP_CHAPTER_MIN=1
SLEEP_CHAPTER_MAX=3

# ---- 导出路径 (export_precise.py) ----
# 兼容 JSON 书稿默认输出目录（~ 会展开为用户主目录；可用 --out-dir 覆盖）
BOOKS_DIR=~/data/weixin/books
