# 微信读书导出 / 书架抓取 — 网页操作 sleep 间隔（单位：秒）
# 复制为 .env 后按需调整；进程环境变量优先生效。
# 完整说明见 AGENTS.md

# ---- 登录会话 (weread_session.py) ----
SLEEP_LOGIN_SWITCH_PC=1
SLEEP_LOGIN_AFTER_GOTO=3
SLEEP_LOGIN_POLL=2

# ---- 书架抓取 (fetch_shelf.py) ----
SLEEP_SHELF_AFTER_LOAD=3
SLEEP_SHELF_SCROLL=3
# 作者为空时逐本打开详情；相邻两本之间的间隔（默认 5）
SLEEP_BOOK_DETAIL_INTERVAL=5
SLEEP_BOOK_DETAIL_LOAD=3
SLEEP_BOOK_DETAIL_CATALOG=1.5

# ---- 阅读器导出 (export_precise.py) ----
SLEEP_READER_AFTER_LOAD=5
SLEEP_READER_CATALOG_OPEN=1.5
SLEEP_READER_CATALOG_SCROLL=1
SLEEP_READER_CATALOG_CLICK=3
SLEEP_READER_CATALOG_CLOSE=2
SLEEP_READER_AFTER_HOOK=0.5
SLEEP_READER_PAGE_TURN=1
SLEEP_READER_PAGE_RENDER=0.3
SLEEP_READER_REOPEN=3
SLEEP_READER_STABLE_POLL=0.5
